#!/usr/bin/env python3
"""Deploy only FIRST backend via verified SSH. No local backend or Docker process."""
import argparse
import datetime
import ipaddress
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
BACKEND = ROOT / 'FIRST/backend'
REMOTE = '/opt/first/backend'
TOP_FILES = {'manage.py', 'requirements.txt', 'Dockerfile', '.dockerignore', 'compose.yaml'}
SOURCE_DIRS = {'accounts', 'projects', 'config', 'deploy'}
OAUTH_KEYS = {'GOOGLE_ENABLED', 'GOOGLE_CLIENT_ID', 'GOOGLE_CLIENT_SECRET', 'GOOGLE_REDIRECT_URI',
              'GOOGLE_LOCAL_REDIRECT_URI',
              'GITHUB_ENABLED', 'GITHUB_CLIENT_ID', 'GITHUB_CLIENT_SECRET', 'GITHUB_REDIRECT_URI',
              'GITHUB_APP_ENABLED', 'GITHUB_APP_ID', 'GITHUB_APP_SLUG', 'GITHUB_APP_CLIENT_ID',
              'GITHUB_APP_CLIENT_SECRET', 'GITHUB_APP_REDIRECT_URI', 'GITHUB_APP_TOKEN_KEY'}
SMTP_KEYS = {'SMTP_HOST', 'SMTP_PORT', 'SMTP_USER', 'SMTP_PASSWORD', 'SMTP_FROM', 'SMTP_TLS', 'SMTP_SSL'}


def read_env():
    values = {}
    for raw in (ROOT / '.env').read_text().splitlines():
        raw = raw.strip()
        if not raw or raw.startswith('#'):
            continue
        key, sep, value = raw.partition('=')
        if not sep or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key.strip()):
            raise ValueError('Invalid .env assignment (values are never executed).')
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[key.strip()] = value
    return values


def source_files():
    files = []
    for path in sorted(BACKEND.rglob('*')):
        relative = path.relative_to(BACKEND)
        if path.is_symlink():
            continue
        if not path.is_file() or any(part in {'tests', '__pycache__', '.venv', '.git', 'node_modules'} for part in relative.parts):
            continue
        if len(relative.parts) == 1 and relative.name in TOP_FILES:
            files.append(path)
        elif (relative.parts[0] in SOURCE_DIRS and path.suffix in {'.py', '.sh', '.conf'}
              and not (path.suffix == '.py' and relative.name.startswith('test'))):
            files.append(path)
    return files


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true', help='List exact backend payload without network or writes')
    parser.add_argument('--check', action='store_true', help='Only inspect deployed FIRST containers and health')
    args = parser.parse_args()
    files = source_files()
    if args.dry_run:
        print('\n'.join(str(p.relative_to(BACKEND)) for p in files))
        print(f'{len(files)} backend files; no .env, frontend, tests, venv, Git or other products.')
        return
    values = read_env()
    host = str(ipaddress.IPv4Address(values['hetzner_sunucu_ip']))
    user = values.get('FIRST_SSH_USER', 'root')
    if not re.fullmatch(r'[a-z_][a-z0-9_-]*', user):
        raise ValueError('Invalid FIRST_SSH_USER')
    ssh = ['ssh', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o', 'ConnectTimeout=15', f'{user}@{host}']
    if args.check:
        subprocess.run(ssh + [f'cd {REMOTE}/current && FIRST_ENV_FILE={REMOTE}/shared/.env docker compose --env-file {REMOTE}/shared/.env -p first ps && curl --fail --silent http://127.0.0.1:18081/health/'], check=True)
        return
    secret = values.get('FIRST_AUTH_PROXY_SECRET', '')
    if len(secret) < 32:
        raise ValueError('Set FIRST_AUTH_PROXY_SECRET (>=32 random characters) in root .env and matching AUTH_PROXY_SECRET in Vercel.')
    config = {key: values[key] for key in SMTP_KEYS if key in values}
    # Read only OAuth settings from the backend env; never replace persistent server credentials.
    if (BACKEND / '.env').exists():
        for line in (BACKEND / '.env').read_text().splitlines():
            key, sep, value = line.partition('=')
            if sep and key in OAUTH_KEYS:
                value = value.strip()
                if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                    value = value[1:-1]
                config[key] = value
    csrf_origins = 'https://first.alicaglarkocer.com'
    local_redirect = config.get('GOOGLE_LOCAL_REDIRECT_URI', '')
    if local_redirect:
        if local_redirect != 'http://127.0.0.1:3101/accounts/google/login/callback/':
            raise ValueError('Only the explicitly approved loopback Google callback is supported')
        csrf_origins += ',http://127.0.0.1:3101'
    config.update(AUTH_PROXY_SECRET=secret, FRONTEND_ORIGIN='https://first.alicaglarkocer.com',
                  CSRF_TRUSTED_ORIGINS=csrf_origins,
                  DJANGO_ALLOWED_HOSTS=f'localhost,127.0.0.1,{host}')
    if any('\n' in value or '\r' in value for value in config.values()):
        raise ValueError('Multiline configuration values are not supported')
    # Deploy exactly the accepted pushed main commit, from the server checkout.
    commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
    if not re.fullmatch(r'[a-f0-9]{40}', commit):
        raise ValueError('Invalid commit')
    branch = subprocess.check_output(['git', 'branch', '--show-current'], cwd=ROOT, text=True).strip()
    dirty = subprocess.check_output(['git', 'status', '--porcelain', '--', 'FIRST/backend', 'send-machine'], cwd=ROOT, text=True).strip()
    if branch != 'main' or dirty:
        raise ValueError('Deploy requires clean backend/deploy sources on main')
    origin = subprocess.check_output(['git', 'remote', 'get-url', 'origin'], cwd=ROOT, text=True).strip()
    allowed_origins = {'https://github.com/caglarkc/4-product-one-community',
                       'https://github.com/caglarkc/4-product-one-community.git',
                       'git@github.com:caglarkc/4-product-one-community.git'}
    if origin not in allowed_origins:
        raise ValueError('Unexpected origin')
    remote_head = subprocess.check_output(['git', 'ls-remote', 'origin', 'refs/heads/main'], cwd=ROOT, text=True).split()
    if not remote_head or remote_head[0] != commit:
        raise ValueError('Push accepted main commit before deployment')
    release = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S') + '-' + commit[:12]
    destination = REMOTE + '/releases/' + release
    # Archive only runtime files. Never extract tracked env or frontend files into a release.
    runtime_paths = ' '.join(shlex.quote(str(path.relative_to(BACKEND))) for path in files)
    remote_script = f"""set -euo pipefail
umask 077
cd /root/first-backend
test -z "$(git status --porcelain)"
test "$(git branch --show-current)" = main
case "$(git remote get-url origin)" in
  https://github.com/caglarkc/4-product-one-community|https://github.com/caglarkc/4-product-one-community.git|git@github.com:caglarkc/4-product-one-community.git) ;;
  *) echo 'Unexpected remote origin'; exit 1 ;;
esac
git pull --ff-only
test "$(git rev-parse HEAD)" = {shlex.quote(commit)}
mkdir -p {shlex.quote(destination)}
git archive HEAD:FIRST/backend {runtime_paths} | tar -x -C {shlex.quote(destination)}
bash {shlex.quote(destination)}/deploy/release.sh {shlex.quote(release)}
"""
    subprocess.run(ssh + ['bash -c ' + shlex.quote(remote_script)], input=json.dumps(config).encode(), check=True)
    print('FIRST backend deployed. Frontend: https://first.alicaglarkocer.com')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as exc:
        # Avoid command/config dumps, which may contain secrets.
        print(f'Deployment stopped: {type(exc).__name__}. Check configuration and preceding non-secret output.', file=sys.stderr)
        sys.exit(1)
