# Generate a unique random value on the server. Never commit the real .env.
DJANGO_SECRET_KEY=
# Add the real API domain before putting it behind a reverse proxy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=first
POSTGRES_USER=first
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Use a unique random hex password (URL-safe). Compose expands this URL.
REDIS_PASSWORD=
AUTH_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# Backend binds only to host loopback; PostgreSQL and Redis stay internal.
FIRST_BACKEND_PORT=18081
AUTH_IP_ATTEMPTS=30
AUTH_ACCOUNT_ATTEMPTS=5
FRONTEND_ORIGIN=https://first.example.invalid
CSRF_TRUSTED_ORIGINS=https://first.example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
SMTP_FROM=noreply@example.invalid
# Optional mounted offline corpus: one SHA-256 password hash per line.
AUTH_BREACHED_PASSWORD_FILE=
# Optional shared ingress assertion key; >=32 characters, matches frontend.
# When set, every /api/auth/ request must carry a valid signed IP assertion.
AUTH_PROXY_SECRET=

# Google OAuth, server-only. Exact callback must be registered in Google Console.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://first.alicaglarkocer.com/accounts/google/login/callback/

# GitHub sign-in OAuth App (repository permissions are separate)
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://first.alicaglarkocer.com/accounts/github/login/callback/
